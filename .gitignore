# Ignore user-specific files
*.suo
*.user
*.userprefs
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Ignore build results
[Bb]uild/
[Bb]inaries/
Intermediate/
Saved/
DerivedDataCache/

# Ignore VS and Rider project files (generated by Unreal)
*.VC.db
*.VC.opendb
*.vscode/
.vs/
.idea/
.vscode/

# Ignore Mac specific
.DS_Store

# Ignore Unreal auto-generated config
*.xcodeproj
*.xcworkspace
*.xcuserstate
*.xcuserdata/

# Ignore backup and autosave files
*.bak
*_Backup
Autosaves/

# Ignore cache and logs
*.log
*.tlog
*.pdb
*.obj
*.exe
*.dll
*.app
*.ipa
*.dSYM
*.sdf
*.opensdf
*.ipch

# Ignore Unreal asset caches and derived files
DerivedDataCache/
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditorUserSettings.ini
Config/DefaultEditorSettings.ini
Config/DefaultEditor.ini
Config/DefaultEngine.ini.backup

# Ignore temporary cooking and packaging output
Saved/Cooked/
Saved/Logs/
Saved/Backup/
Saved/Temp/
Saved/StagedBuilds/
Saved/Crashes/
Saved/Collections/
Saved/Scalability/

# Ignore Local and Platform-Specific Saved folders
Saved/LocalBuilds/
Saved/Swarm/
Saved/UnrealBuildTool/

# Ignore crash reports and profiling
*.dump
*.dmp
*.udump
*.prof

# Ignore external dependencies (optional, if stored locally)
Plugins/*/Intermediate/
Plugins/*/Binaries/
Plugins/*/DerivedDataCache/

# Ignore project-specific caches
*.generated.*
*.gen.*
*.target
*.modules
*.rsp

# Ignore packaged builds
WindowsNoEditor/
LinuxNoEditor/
MacNoEditor/
Android_ASTC/
Android_ETC2/
Android_DXT/
IOS/

# Ignore engine source (if you’re using prebuilt engine)
Engine/
!Engine/Source/
!Engine/Plugins/

# Optional: Ignore Rider / CLion settings
.idea/

# Ignore temporary files from OS or tools
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp

# Ignore version control helper files
*.orig
*.rej
*.patch
*.diff

# Optional: keep content and config
!Content/
!Config/
!Source/
!*.uproject
!*.uplugin
